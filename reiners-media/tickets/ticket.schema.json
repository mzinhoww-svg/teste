{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "status",
    "priority",
    "type",
    "epic",
    "wave",
    "parallel_group",
    "recommended_agent",
    "independence_score",
    "estimated_size",
    "risk_level",
    "objective",
    "business_value",
    "requirements",
    "scope",
    "dependencies",
    "read_paths",
    "write_paths",
    "forbidden_paths",
    "deliverables",
    "acceptance_criteria",
    "test_plan",
    "validation_commands",
    "definition_of_ready",
    "definition_of_done"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TCK-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": [
        "BACKLOG",
        "READY",
        "CLAIMED",
        "IN_PROGRESS",
        "BLOCKED",
        "IN_REVIEW",
        "CHANGES_REQUESTED",
        "APPROVED",
        "INTEGRATING",
        "DONE",
        "CANCELLED"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "type": {
      "enum": [
        "feature",
        "bug",
        "chore",
        "docs",
        "test",
        "refactor",
        "integration"
      ]
    },
    "epic": {
      "type": "string"
    },
    "wave": {
      "type": "integer",
      "minimum": 0
    },
    "parallel_group": {
      "type": "string"
    },
    "recommended_agent": {
      "type": "string"
    },
    "independence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "estimated_size": {
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "objective": {
      "type": "string"
    },
    "business_value": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_reasons": {
      "type": "object"
    },
    "contracts_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts_produced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_plan": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "e2e": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regression": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observability_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentation_updates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition_of_ready": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "CHANGES_REQUESTED",
            "APPROVED"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}