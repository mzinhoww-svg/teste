# Modelo do arquivo /opt/atendente/.env (o instalar-atendente.sh cria o de verdade
# e pede cada segredo no terminal). NUNCA coloque valores reais aqui: este arquivo
# vai para um repositório público.

# Endereço do WA-AKG DENTRO da rede do Docker.
WA_AKG_URL=http://app:3000
# Nome da sessão do WhatsApp no WA-AKG.
WA_AKG_SESSION=COLE_AQUI
# Chave de API do WA-AKG.
WA_AKG_KEY=COLE_AQUI
# Chave do OpenRouter (defina o teto de gasto na própria chave).
OPENROUTER_API_KEY=COLE_AQUI
# Gerados sozinhos pelo instalador (openssl rand -hex 32).
WEBHOOK_SEGREDO=COLE_AQUI
SEGREDO_SESSAO=COLE_AQUI
# Quem entra na tela, no formato nome:senha,nome:senha
USUARIOS=nome1:COLE_AQUI,nome2:COLE_AQUI
# Números da equipe que recebem avisos, com DDI e DDD, separados por vírgula.
# Exemplo fictício: 55659999000NN
AVISAR_NUMEROS=55659999000NN
# Fotos dos cenários usadas nas respostas.
FOTOS_URL=https://reiners.agency/fotos-cenarios
