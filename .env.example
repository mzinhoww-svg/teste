# Provedor de IA dos agentes. Configure UMA das opções abaixo.
# Sem nenhuma, o app funciona com heurística determinística.

# Opção 1 (recomendada): OpenRouter usando GLM 5.2
OPENROUTER_API_KEY=
# Opcional — sobrescreve o modelo padrão (z-ai/glm-5.2)
OPENROUTER_MODEL=z-ai/glm-5.2

# Opção 2: Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
