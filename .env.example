# ---- Supabase (banco + auth) — obrigatório ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- IA dos agentes ----
# OpenRouter usando GLM 5.2 (recomendado). Sem chave, os agentes usam heurística.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
# Alternativa: Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Admin da plataforma (fallback além da tabela platform_admins) ----
PLATFORM_ADMIN_EMAILS=
# ---- URL pública do app (convites, OpenSign callback, canonical) ----
NEXT_PUBLIC_APP_URL=

# ---- Cadências run_agent (Vercel Cron) ----
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Assinatura digital (OpenSign — open source, grátis) ----
# https://github.com/OpenSignLabs/OpenSign — self-host ou instância própria.
# Sem estas variáveis o app usa um provider "mock" (não faz rede) — útil em dev/testes.
SIGNATURE_PROVIDER=opensign
OPENSIGN_BASE_URL=https://sua-instancia-opensign.exemplo
OPENSIGN_API_KEY=
OPENSIGN_WEBHOOK_SECRET=
OPENSIGN_DEFAULT_TEMPLATE_ID=

# ---- Testes E2E (Playwright) — opcional, ver docs/testing.md ----
# Sem E2E_BASE_URL, o Playwright sobe o app local com placeholders e testa a
# superfície pública. Defina abaixo para testar um preview real (fluxos logados).
# E2E_BASE_URL=https://seu-preview.vercel.app
# E2E_EMAIL=usuario-de-teste@exemplo.com
# E2E_PASSWORD=senha-de-teste
# Aponta para um Chromium já instalado (ambientes que não baixam o browser):
# PLAYWRIGHT_CHROMIUM_PATH=/caminho/para/chrome
