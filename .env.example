# ---- Supabase (banco + auth) — obrigatório ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- IA dos agentes ----
# OpenRouter usando GLM 5.2 (recomendado). Sem chave, os agentes usam heurística.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
# Alternativa: Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Admin da plataforma (fallback além da tabela platform_admins) ----
PLATFORM_ADMIN_EMAILS=
# ---- URL pública do app (convites, OpenSign callback, canonical) ----
NEXT_PUBLIC_APP_URL=

# ---- Roteamento por subdomínio (produção) ----
# Raiz dos domínios. Ex.: reiners.agency → landing no apex,
# crm.reiners.agency → CRM interno (/app), app.reiners.agency → portal (/portal).
# Vazio em dev/preview: o roteamento cai para PATH (/app, /portal/[cliente]).
NEXT_PUBLIC_ROOT_DOMAIN=

# ---- Cadências run_agent (Vercel Cron) ----
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Assinatura digital (OpenSign — open source, grátis) ----
# https://github.com/OpenSignLabs/OpenSign — self-host ou instância própria.
# Sem estas variáveis o app usa um provider "mock" (não faz rede) — útil em dev/testes.
SIGNATURE_PROVIDER=opensign
OPENSIGN_BASE_URL=https://sua-instancia-opensign.exemplo
OPENSIGN_API_KEY=
OPENSIGN_API_VERSION=v1.2
OPENSIGN_WEBHOOK_SECRET=
OPENSIGN_DEFAULT_TEMPLATE_ID=
OPENSIGN_FOLDER_ID=

# ---- Agentes: padrão global da plataforma ----
# Os 9 agentes são definidos pelo admin da plataforma e herdados por todos os
# tenants. Com a flag abaixo em "true", owner/admin do tenant pode sobrescrever
# um agente localmente (deixando de herdar o padrão). Padrão: somente herança.
ALLOW_TENANT_AGENT_OVERRIDES=false

# ---- WhatsApp (bridge externo — WPPConnect/Baileys self-hosted) ----
# wa_me: envio manual por link (padrão, sem serviço externo).
# bridge: lê conversas de um serviço externo persistente (NÃO roda na Vercel).
# fake: provider de teste, sem rede.
WHATSAPP_PROVIDER=wa_me
WHATSAPP_BRIDGE_BASE_URL=
WHATSAPP_BRIDGE_API_KEY=
WHATSAPP_BRIDGE_WEBHOOK_SECRET=
WHATSAPP_BRIDGE_DEFAULT_INSTANCE=
WHATSAPP_READ_MAX_MESSAGES=80
WHATSAPP_SUMMARY_MAX_CHARS=4000

# ---- Enriquecimento (APIs públicas gratuitas) ----
# BrasilAPI (CNPJ/CEP) não exige chave. Fallback OpenCNPJ idem.
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# ---- Testes E2E (Playwright) — opcional, ver docs/testing.md ----
# Sem E2E_BASE_URL, o Playwright sobe o app local com placeholders e testa a
# superfície pública. Defina abaixo para testar um preview real (fluxos logados).
# E2E_BASE_URL=https://seu-preview.vercel.app
# E2E_EMAIL=usuario-de-teste@exemplo.com
# E2E_PASSWORD=senha-de-teste
# Aponta para um Chromium já instalado (ambientes que não baixam o browser):
# PLAYWRIGHT_CHROMIUM_PATH=/caminho/para/chrome
