# Copie para .env e ajuste se necessário. Tudo opcional — há defaults sensatos.

# Porta do servidor local
PORT=4321

# LLM local (Ollama). Deixe assim para usar o Ollama padrão da sua máquina.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Onde o banco SQLite fica gravado (padrão: ./data)
# CRM_DATA_DIR=./data
